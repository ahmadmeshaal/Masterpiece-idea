// =====================================================================
// Taqaddomi: database schema (paste into dbdiagram.io)
// Based on your draft + streaks, moderation, bilingual categories, AI.
// No gamification (no XP, badges, shields, challenges).
// =====================================================================

Enum user_role {
  user
  admin
}

Enum tracker_type {
  journey   // daily journey: Day 1, Day 2...
  habit     // flexible: attempts / sessions / updates
}

Enum visibility_type {
  public
  private
}

Enum tracker_status {
  active
  completed
  archived
}

Enum counter_label {
  day       // used by journey trackers
  attempt
  session
  update
}

Enum target_type {
  none        // counter only, no streak
  weekdays    // specific days, e.g. Sat, Mon, Wed
  frequency   // X times per week / month
}

Enum frequency_period {
  day
  week
  month
}

Enum streak_unit {
  day
  week
  none
}

Enum media_type {
  image
  video
  link
}

Enum report_target {
  post
  comment
  tracker
  user
}

Enum report_reason {
  spam
  inappropriate
  harassment
  other
}

Enum report_status {
  open
  reviewed
  dismissed
}

Enum ai_summary_type {
  monthly_recap
  progress_analysis
}

Enum ai_feature {
  writing_helper
  recap
  analysis
  recommendations
}

Enum subscription_plan {
  free
  premium
}

Enum subscription_status {
  active
  cancelled
  expired
}

// ---------------------------------------------------------------------
// USERS AND CATEGORIES
// ---------------------------------------------------------------------

Table users {
  id bigint [pk, increment]
  name varchar(100) [not null]
  username varchar(50) [not null, unique]
  email varchar(255) [not null, unique]
  email_verified_at timestamp
  password varchar(255) [not null]
  role user_role [not null, default: 'user']
  avatar_key varchar(500)
  bio varchar(500)
  timezone varchar(64) [not null, default: 'UTC', note: 'decides when a day starts for streaks']
  locale varchar(5) [not null, default: 'en']
  theme varchar(10) [not null, default: 'system']
  followers_count int [not null, default: 0]
  following_count int [not null, default: 0]
  remember_token varchar(100)
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table categories {
  id bigint [pk, increment]
  parent_id bigint [note: 'NULL = main category']
  name_en varchar(100) [not null]
  name_ar varchar(100) [not null]
  slug varchar(120) [not null, unique]
  icon varchar(60)
  sort_order smallint [not null, default: 0]
  created_at timestamp
  updated_at timestamp
}

// ---------------------------------------------------------------------
// TRACKERS AND ENTRIES
// ---------------------------------------------------------------------

Table trackers {
  id bigint [pk, increment]
  user_id bigint [not null]
  category_id bigint [not null]
  type tracker_type [not null]
  counter_label counter_label [not null, default: 'day', note: 'journey = day; habit = attempt / session / update']
  title varchar(150) [not null]
  description text
  cover_image_key varchar(500)
  visibility visibility_type [not null, default: 'private']
  status tracker_status [not null, default: 'active']
  start_date date [not null]
  target_date date [note: 'deadline; can be extended any time']
  completed_at timestamp
  completion_source varchar(20) [note: 'deadline | manual']

  streak_unit streak_unit [not null, default: 'day']
  current_streak int [not null, default: 0]
  best_streak int [not null, default: 0]
  last_entry_date date

  entries_count int [not null, default: 0]

  created_at timestamp
  updated_at timestamp
  deleted_at timestamp

  indexes {
    (user_id, status)
    (status, target_date)
    (visibility, status, category_id, created_at)
  }
}

Table tracker_habits {
  tracker_id bigint [pk]
  target_type target_type [not null, default: 'none']
  weekdays json [note: 'e.g. [6,1,3] = Sat, Mon, Wed (used when target_type = weekdays)']
  frequency_count smallint [note: 'used when target_type = frequency']
  frequency_period frequency_period
  created_at timestamp
  updated_at timestamp
}

Table progress_entries {
  id bigint [pk, increment]
  tracker_id bigint [not null]
  entry_number int [not null, note: 'shown as Day 12 / Attempt 3, calculated automatically']
  entry_date date [not null, note: 'in the user timezone, not UTC']
  title varchar(150)
  note text
  duration_minutes smallint
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp

  indexes {
    (tracker_id, entry_date)
  }
}

Table progress_media {
  id bigint [pk, increment]
  progress_entry_id bigint [not null]
  type media_type [not null]
  storage_disk varchar(50)
  storage_key varchar(500)
  external_url varchar(2048)
  mime_type varchar(100)
  size_bytes bigint
  caption varchar(500)
  sort_order smallint [not null, default: 0]
  created_at timestamp

  indexes {
    (progress_entry_id, sort_order)
  }
}

// ---------------------------------------------------------------------
// COMMUNITY
// ---------------------------------------------------------------------

Table posts {
  id bigint [pk, increment]
  progress_entry_id bigint [not null, unique, note: 'an entry becomes a post when published']
  user_id bigint [not null, note: 'copied for fast feed queries']
  tracker_id bigint [not null, note: 'copied for fast feed queries']
  title varchar(150)
  content text
  reactions_count int [not null, default: 0]
  comments_count int [not null, default: 0]
  created_at timestamp
  updated_at timestamp

  indexes {
    created_at
    (user_id, created_at)
    (tracker_id, created_at)
  }
}

Table follows {
  follower_id bigint [not null]
  following_id bigint [not null]
  created_at timestamp

  indexes {
    (follower_id, following_id) [pk]
    (following_id, created_at)
  }
}

Table reactions {
  id bigint [pk, increment]
  user_id bigint [not null]
  post_id bigint [not null]
  type varchar(20) [not null, note: 'like | love | cheer | applaud | idea | sad']
  created_at timestamp
  updated_at timestamp

  indexes {
    (user_id, post_id) [unique]
    (post_id, type)
  }
}

Table comments {
  id bigint [pk, increment]
  user_id bigint [not null]
  post_id bigint [not null]
  parent_id bigint [note: 'reply to another comment']
  content text [not null]
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (post_id, created_at)
    parent_id
  }
}

Table blocks {
  blocker_id bigint [not null]
  blocked_id bigint [not null]
  created_at timestamp

  indexes {
    (blocker_id, blocked_id) [pk]
  }
}

Table reports {
  id bigint [pk, increment]
  reporter_id bigint [not null]
  target_type report_target [not null]
  target_id bigint [not null]
  reason report_reason [not null]
  details varchar(500)
  status report_status [not null, default: 'open']
  handled_by bigint
  created_at timestamp
  updated_at timestamp

  indexes {
    (status, created_at)
    (target_type, target_id)
  }
}

Table notifications {
  id bigint [pk, increment]
  user_id bigint [not null]
  actor_id bigint
  type varchar(30) [not null, note: 'follow | reaction | comment | reply | deadline_soon | tracker_completed | streak_at_risk | recap_ready']
  reference_type varchar(50)
  reference_id bigint
  read_at timestamp
  created_at timestamp

  indexes {
    (user_id, read_at, created_at)
    (reference_type, reference_id)
  }
}

// ---------------------------------------------------------------------
// AI AND SUBSCRIPTIONS
// ---------------------------------------------------------------------

Table ai_summaries {
  id bigint [pk, increment]
  user_id bigint [not null]
  tracker_id bigint [note: 'NULL = all trackers']
  type ai_summary_type [not null]
  period_start date
  period_end date
  content json [not null, note: 'achieved items, next steps, stats']
  created_at timestamp

  indexes {
    (user_id, type, period_start)
  }
}

Table ai_usage {
  id bigint [pk, increment]
  user_id bigint [not null]
  feature ai_feature [not null]
  tokens int
  created_at timestamp

  indexes {
    (user_id, created_at)
  }
}

Table subscriptions {
  id bigint [pk, increment]
  user_id bigint [not null]
  plan subscription_plan [not null, default: 'free']
  status subscription_status [not null, default: 'active']
  started_at timestamp
  expires_at timestamp
  created_at timestamp
  updated_at timestamp

  indexes {
    (user_id, status)
  }
}

// ---------------------------------------------------------------------
// RELATIONSHIPS
// ---------------------------------------------------------------------

Ref: categories.parent_id > categories.id [delete: set null]

Ref: trackers.user_id > users.id [delete: cascade]
Ref: trackers.category_id > categories.id

Ref: tracker_habits.tracker_id - trackers.id [delete: cascade]

Ref: progress_entries.tracker_id > trackers.id [delete: cascade]
Ref: progress_media.progress_entry_id > progress_entries.id [delete: cascade]

Ref: posts.progress_entry_id - progress_entries.id [delete: cascade]
Ref: posts.user_id > users.id [delete: cascade]
Ref: posts.tracker_id > trackers.id [delete: cascade]

Ref: follows.follower_id > users.id [delete: cascade]
Ref: follows.following_id > users.id [delete: cascade]

Ref: reactions.user_id > users.id [delete: cascade]
Ref: reactions.post_id > posts.id [delete: cascade]

Ref: comments.user_id > users.id [delete: cascade]
Ref: comments.post_id > posts.id [delete: cascade]
Ref: comments.parent_id > comments.id [delete: cascade]

Ref: blocks.blocker_id > users.id [delete: cascade]
Ref: blocks.blocked_id > users.id [delete: cascade]

Ref: reports.reporter_id > users.id [delete: cascade]
Ref: reports.handled_by > users.id [delete: set null]

Ref: notifications.user_id > users.id [delete: cascade]
Ref: notifications.actor_id > users.id [delete: set null]

Ref: ai_summaries.user_id > users.id [delete: cascade]
Ref: ai_summaries.tracker_id > trackers.id [delete: cascade]
Ref: ai_usage.user_id > users.id [delete: cascade]

Ref: subscriptions.user_id > users.id [delete: cascade]
